// Sprites (ADR 0023) for frontends that draw them; the window shows them on F2.
// `atlas` is beside this file; `cell` is one sprite in pixels, the shape of
// a terminal cell. A sprite's `frames` are atlas cells (column, row), shown
// `frame_ms` each in turn. Blueprints name a sprite in `Appearance(sprite:)`;
// `terrain` maps a tile (game::Tile) to its sprite, and one left out is drawn
// as its glyph. tiles.png is a placeholder.
(
    atlas: "tiles.png",
    cell: (8, 16),
    terrain: {Floor: "floor", Wall: "wall", StairsDown: "stairs down"},
    sprites: {
        "floor": (frames: [(0, 0)]),
        "wall": (frames: [(1, 0)]),
        "stairs down": (frames: [(2, 0)]),
        "player": (frames: [(0, 1)]),
        "goblin": (frames: [(1, 1), (2, 1)], frame_ms: 600),
        "torch": (frames: [(3, 1), (4, 1)], frame_ms: 180),
    },
)
