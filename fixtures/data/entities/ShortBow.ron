// Shoots arrows from the quiver on your back, or one you nocked by hand.
// Up close you strike with it, weakly: a bump hits with the bow, not a fist.
(
    components: [
        Name("short bow"),
        Appearance(glyph: '}', fg: (160, 110, 60), bg: (0, 0, 0)),
        Item,
        Equippable(part: Hand),
        // Steady to four tiles; each beyond costs 5% to hit.
        Launcher(range: 9, ammo: Arrow, stat: Agility, steady: 4),
        Weapon(min: 2, max: 3, stat: Strength, types: [Blunt]),
        Trains(["Bow", "Short bow"]),
    ],
)
