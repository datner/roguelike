// The archer's skills plus kicking, following bow dancing at 5: the style
// waives point blank and gathers its arrows, so it shoots up close all fight
// long, tripping between shots.
(
    name: "bow dancer",
    note: "the archer following Bow dancing at 5 with the push kick and the parting shot",
    skills: {
        "Melee": 5,
        "Archery": 5,
        "Bow": 5,
        "Pierce": 5,
        "Blunt": 5,
        "Unarmed": 5,
        "Bow dancing": 5,
    },
    equipment: ["ShortBow", "Quiver", "Torch"],
    techniques: ["PushKick", "PartingShot"],
    style: "BowDancing",
    // No push kick or parting shot: both open distance a doll never closes
    // again, so its arrows would land out of reach. A real enemy walks back.
    policy: [Perform("Trip"), Fire, Bump],
)
