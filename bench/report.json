const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

function el(tag, attrs = {}, text) {
  const node = document.createElementNS(NS, tag);
  for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
  if (text != null) node.textContent = text;
  return node;
}

/** A tidy axis maximum and its tick step for values up to `max`. */
function ticks(max) {
  const raw = max / 4 || 1;
  const mag = 10 ** Math.floor(Math.log10(raw));
  const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= raw);
  return { step, top: Math.ceil(max / step) * step || step };
}

function render() {
  if (!REPORT) {
    $("meta").textContent = "No report filled in: run scripts/balance.sh --page FILE.";
    return;
  }
  const first = REPORT.scenarios[0];
  const row = (build, scenario) => REPORT.rows.find((r) => r.build === build && r.scenario === scenario);
  $("meta").textContent =
    `${REPORT.builds.length} builds · ${REPORT.scenarios.length} scenarios · ${REPORT.seeds} seeds · ` +
    `burst ${REPORT.burst} ticks · sustained ${REPORT.sustained} ticks · damage per 100 ticks (one turn)`;

  const reading = $("reading");
  if (!reading.querySelector("p, ul, ol")) reading.hidden = true;

  // Scatter: damage per turn (sustained, first scenario) against XP to build.
  const points = REPORT.builds.map((b) => ({ name: b.name, xp: b.xp, dmg: row(b.name, first)?.sustained.mean ?? 0, standing: b.standing }));
  const outlier = (p) => p.standing != null && p.standing >= REPORT.outlier;
  $("scatter-note").textContent =
    `Sustained damage per turn against "${first}", by the XP its skills hold. ` +
    `Amber marks a build ${REPORT.outlier}× or more above its peers, the builds within a factor of two of its XP.`;
  {
    const W = 720, H = 340, L = 56, R = 140, T = 16, B = 44;
    const x = ticks(Math.max(...points.map((p) => p.xp), 1));
    const y = ticks(Math.max(...points.map((p) => p.dmg), 1));
    const sx = (v) => L + (v / x.top) * (W - L - R);
    const sy = (v) => H - B - (v / y.top) * (H - T - B);
    const svg = el("svg", { viewBox: `0 0 ${W} ${H}`, role: "img", "aria-label": "Damage per turn against XP to build" });
    for (let v = 0; v <= y.top + 1e-9; v += y.step) {
      svg.append(el("line", { x1: L, x2: W - R, y1: sy(v), y2: sy(v), stroke: "var(--rule)" }));
      svg.append(el("text", { x: L - 8, y: sy(v) + 4, "text-anchor": "end", "font-size": 11, fill: "var(--muted)" }, fmt(v, 1)));
    }
    for (let v = 0; v <= x.top + 1e-9; v += x.step) {
      svg.append(el("text", { x: sx(v), y: H - B + 18, "text-anchor": "middle", "font-size": 11, fill: "var(--muted)" }, Math.round(v)));
    }
    svg.append(el("text", { x: (L + W - R) / 2, y: H - 6, "text-anchor": "middle", "font-size": 11, fill: "var(--muted)" }, "XP to build"));
    svg.append(el("text", { x: 12, y: (T + H - B) / 2, "font-size": 11, fill: "var(--muted)", transform: `rotate(-90 12 ${(T + H - B) / 2})`, "text-anchor": "middle" }, "damage per turn"));
    // Labels sorted top to bottom, nudged apart so none overlap.
    const placed = [];
    [...points].sort((a, b) => b.dmg - a.dmg).forEach((p) => {
      const flagged = outlier(p);
      const cx = sx(p.xp), cy = sy(p.dmg);
      svg.append(el("circle", { cx, cy, r: flagged ? 6 : 4.5, fill: flagged ? "var(--accent)" : "var(--mark)" }));
      let ly = cy + 4;
      while (placed.some((q) => Math.abs(q.y - ly) < 13 && Math.abs(q.x - cx) < 130)) ly += 13;
      placed.push({ x: cx, y: ly });
      svg.append(el("text", { x: cx + 9, y: ly, "font-size": 11, fill: flagged ? "var(--accent)" : "var(--fg)" }, p.name));
    });
    $("scatter").append(svg);
  }

  // Scenario tabs, remembered per viewer.
  let current = first;
  try { const saved = localStorage.getItem("scenario"); if (REPORT.scenarios.includes(saved)) current = saved; } catch {}
  const tabs = $("tabs");
  REPORT.scenarios.forEach((name) => {
    const b = document.createElement("button");
    b.type = "button"; b.textContent = name; b.id = "tab-" + REPORT.scenarios.indexOf(name);
    b.addEventListener("click", () => { current = name; try { localStorage.setItem("scenario", name); } catch {} drawScenario(); });
    tabs.append(b);
  });

  function drawScenario() {
    [...tabs.children].forEach((b) => b.setAttribute("aria-pressed", String(b.textContent === current)));
    const rows = REPORT.builds.map((b) => ({ name: b.name, r: row(b.name, current) })).filter((x) => x.r);
    const W = 720, rowH = 30, L = 130, R = 60, T = 24;
    const H = T + rows.length * rowH + 10;
    const top = ticks(Math.max(...rows.map((x) => Math.max(x.r.burst.high, x.r.sustained.high)), 1)).top;
    const sx = (v) => L + (v / top) * (W - L - R);
    const svg = el("svg", { viewBox: `0 0 ${W} ${H}`, role: "img", "aria-label": `Burst and sustained damage, ${current}` });
    svg.append(el("rect", { x: L, y: 4, width: 10, height: 10, fill: "var(--mark-soft)" }));
    svg.append(el("text", { x: L + 15, y: 13, "font-size": 11, fill: "var(--muted)" }, "burst"));
    svg.append(el("rect", { x: L + 70, y: 4, width: 10, height: 10, fill: "var(--mark)" }));
    svg.append(el("text", { x: L + 85, y: 13, "font-size": 11, fill: "var(--muted)" }, "sustained (line: 10th–90th)"));
    rows.forEach(({ name, r }, i) => {
      const y = T + i * rowH;
      svg.append(el("text", { x: L - 10, y: y + 16, "text-anchor": "end", "font-size": 12, fill: "var(--fg)" }, name));
      svg.append(el("rect", { x: L, y: y + 3, width: Math.max(0, sx(r.burst.mean) - L), height: 9, fill: "var(--mark-soft)" }));
      svg.append(el("rect", { x: L, y: y + 13, width: Math.max(0, sx(r.sustained.mean) - L), height: 9, fill: "var(--mark)" }));
      svg.append(el("line", { x1: sx(r.sustained.low), x2: sx(r.sustained.high), y1: y + 17.5, y2: y + 17.5, stroke: "var(--fg)", "stroke-width": 1 }));
      svg.append(el("text", { x: sx(Math.max(r.burst.mean, r.sustained.high)) + 6, y: y + 16, "font-size": 11, fill: "var(--muted)" }, fmt(r.sustained.mean)));
    });
    $("bars").replaceChildren(svg);

    const head = "<tr><th>build</th><th>burst</th><th>sustained</th><th>10th–90th</th><th>landed</th><th>grazed</th></tr>";
    const body = rows.map(({ name, r }) =>
      `<tr><td>${esc(name)}</td><td>${fmt(r.burst.mean)}</td><td>${fmt(r.sustained.mean)}</td>` +
      `<td class="spread">${fmt(r.sustained.low)}–${fmt(r.sustained.high)}</td>` +
      `<td>${Math.round(r.sustained.landed * 100)}%</td><td>${Math.round(r.sustained.grazed * 100)}%</td></tr>`).join("");
    $("table").innerHTML = head + body;
  }
  drawScenario();

  // What moved since the committed report: sustained means that shifted.
  const moved = $("moved");
  if (!PREVIOUS) {
    moved.innerHTML = '<p class="empty">No committed report to compare with.</p>';
  } else {
    const was = (b, s) => PREVIOUS.rows.find((r) => r.build === b && r.scenario === s);
    const changes = REPORT.rows.map((r) => ({ r, p: was(r.build, r.scenario) }))
      .map(({ r, p }) => ({ build: r.build, scenario: r.scenario, now: r.sustained.mean, then: p?.sustained.mean }))
      .filter((c) => c.then == null || Math.abs(c.now - c.then) >= 0.05);
    const gone = PREVIOUS.builds.filter((b) => !REPORT.builds.some((n) => n.name === b.name)).map((b) => b.name);
    if (!changes.length && !gone.length) {
      moved.innerHTML = '<p class="empty">Nothing moved by 0.05 damage per turn or more.</p>';
    } else {
      const rows = changes.map((c) => {
        const delta = c.then == null ? "new" : (c.now - c.then >= 0 ? "+" : "") + fmt(c.now - c.then);
        const cls = c.then == null ? "" : c.now > c.then ? "up" : "down";
        return `<tr><td>${esc(c.build)}</td><td>${esc(c.scenario)}</td><td>${fmt(c.then)}</td><td>${fmt(c.now)}</td><td class="${cls}">${delta}</td></tr>`;
      }).join("");
      const goneRow = gone.length ? `<p class="note">Removed: ${gone.map(esc).join(", ")}</p>` : "";
      moved.innerHTML = `<div class="scroll"><table><tr><th>build</th><th>scenario</th><th>was</th><th>now</th><th>change</th></tr>${rows}</table></div>${goneRow}`;
    }
  }

  // When each resource ran dry, over the sustained window.
  $("dry-note").textContent =
    `Average tick a resource first ran dry against "${first}", in runs that did; the share of runs beside it. ` +
    `The shaded band is the burst window.`;
  {
    const dried = [];
    REPORT.builds.forEach((b) => {
      const r = row(b.name, first);
      if (!r) return;
      for (const res of ["mana", "stamina", "arrows"]) {
        const u = r.sustained[res];
        if (u.dry_at != null) dried.push({ name: b.name, res, at: u.dry_at, share: u.dry });
      }
    });
    if (!dried.length) {
      $("dry").innerHTML = '<p class="empty">No build ran dry of anything.</p>';
    } else {
      const W = 720, rowH = 24, L = 190, R = 70, T = 8, B = 28;
      const H = T + dried.length * rowH + B;
      const sx = (v) => L + (v / REPORT.sustained) * (W - L - R);
      const svg = el("svg", { viewBox: `0 0 ${W} ${H}`, role: "img", "aria-label": "When resources ran dry" });
      svg.append(el("rect", { x: L, y: T, width: sx(REPORT.burst) - L, height: H - T - B, fill: "var(--rule)" }));
      for (let v = 0; v <= REPORT.sustained; v += REPORT.sustained / 5) {
        svg.append(el("text", { x: sx(v), y: H - 8, "text-anchor": "middle", "font-size": 11, fill: "var(--muted)" }, v));
      }
      dried.forEach((d, i) => {
        const y = T + i * rowH + 12;
        const early = d.at < REPORT.burst && d.share >= 0.5;
        svg.append(el("text", { x: L - 10, y: y + 4, "text-anchor": "end", "font-size": 12, fill: "var(--fg)" }, `${d.name} · ${d.res}`));
        svg.append(el("line", { x1: L, x2: sx(d.at), y1: y, y2: y, stroke: "var(--mark-soft)", "stroke-width": 2 }));
        svg.append(el("circle", { cx: sx(d.at), cy: y, r: 5, fill: early ? "var(--accent)" : "var(--mark)" }));
        svg.append(el("text", { x: sx(d.at) + 9, y: y + 4, "font-size": 11, fill: early ? "var(--accent)" : "var(--muted)" }, `${Math.round(d.share * 100)}%`));
      });
      $("dry").append(svg);
    }
  }

  // Sources, one disclosure per build.
  $("needs").innerHTML = REPORT.builds.map((b) => {
    const items = b.needs.length
      ? b.needs.map((n) => `<li>${esc(n.thing)} <span>— ${n.from.length ? n.from.map(esc).join("; ") : "nothing in the content gives it"}</span></li>`).join("")
      : "<li><span>nothing beyond its skills</span></li>";
    return `<details><summary>${esc(b.name)} · ${b.xp} XP</summary><p class="note">${esc(b.note)}</p><ul>${items}</ul></details>`;
  }).join("");

  renderFloors();
}

/** The floor bot's dives: who survives each floor, and the numbers against their targets. */
function renderFloors() {
  const dives = REPORT.dives;
  if (!dives || !dives.rows.length) {
    $("floors-panel").hidden = true;
    $("off-panel").hidden = true;
    return;
  }
  const t = dives.targets;
  const inside = (v, [lo, hi]) => v == null || (v >= lo && v <= hi);
  const names = [...new Set(dives.rows.map((r) => r.dive))];
  $("floors-note").textContent =
    `The floor bot plays each build from camp through real floors, fighting what it sees and exploring the rest. ` +
    `Bars: the share of runs that reached each floor. Amber marks a number outside its target ` +
    `(fight ${t.fight[0]}–${t.fight[1]} keypresses, floor ${t.floor[0]}–${t.floor[1]}).`;

  let current = names[0];
  try { const saved = localStorage.getItem("dive"); if (names.includes(saved)) current = saved; } catch {}
  const tabs = $("dive-tabs");
  names.forEach((name) => {
    const b = document.createElement("button");
    b.type = "button"; b.textContent = name;
    b.addEventListener("click", () => { current = name; try { localStorage.setItem("dive", name); } catch {} draw(); });
    tabs.append(b);
  });

  function draw() {
    [...tabs.children].forEach((b) => b.setAttribute("aria-pressed", String(b.textContent === current)));
    const rows = dives.rows.filter((r) => r.dive === current);
    const floors = Math.max(...rows.map((r) => r.floors_asked), 1);
    const W = 720, rowH = 34, L = 130, R = 10, T = 18, gap = 4;
    const H = T + rows.length * rowH + 6;
    const cell = (W - L - R) / floors;
    const svg = el("svg", { viewBox: `0 0 ${W} ${H}`, role: "img", "aria-label": `Runs reaching each floor, ${current}` });
    for (let f = 0; f < floors; f++) {
      svg.append(el("text", { x: L + f * cell + cell / 2, y: 12, "text-anchor": "middle", "font-size": 11, fill: "var(--muted)" }, `floor ${f + 1}`));
    }
    rows.forEach((r, i) => {
      const y = T + i * rowH;
      svg.append(el("text", { x: L - 10, y: y + rowH / 2 + 4, "text-anchor": "end", "font-size": 12, fill: "var(--fg)" }, r.build));
      for (let f = 0; f < floors; f++) {
        const share = (r.floors[f]?.reached ?? 0) / r.runs;
        const h = (rowH - 8) * share;
        svg.append(el("rect", { x: L + f * cell + gap, y: y + 2, width: cell - 2 * gap, height: rowH - 8, fill: "var(--rule)" }));
        const bar = el("rect", { x: L + f * cell + gap, y: y + 2 + (rowH - 8 - h), width: cell - 2 * gap, height: h, fill: "var(--mark)" });
        bar.append(el("title", {}, `${r.build}, floor ${f + 1}: ${Math.round(share * 100)}% of runs`));
        svg.append(bar);
      }
    });
    $("survival").replaceChildren(svg);

    const levels = t.levels.map((l) => l.level);
    const head = `<tr><th>build</th><th>keypresses / floor</th><th>fight length</th><th>most trained</th>` +
      levels.map((l) => `<th>floors to ${l}</th>`).join("") + `<th>ended</th></tr>`;
    const body = rows.map((r) => {
      const keys = r.floors.reduce((s, f) => s + f.keypresses.mean, 0) / Math.max(r.floors.length, 1);
      const fights = r.floors.reduce((s, f) => s + f.fights * f.reached, 0);
      const fight = fights ? r.floors.reduce((s, f) => s + f.fight.mean * f.fights * f.reached, 0) / fights : null;
      const flag = (ok, text) => `<td${ok ? "" : ' class="flag"'}>${text}</td>`;
      const reach = t.levels.map((l) => {
        const x = r.reach.find((q) => q.level === l.level);
        const text = x?.floors == null ? "never" : (x.extrapolated ? "~" : "") + Math.round(x.floors);
        return flag(x?.floors != null && inside(x.floors, l.floors), text);
      }).join("");
      const died = r.causes.map(([c, n]) => `${esc(c)} ${n}`).join(", ");
      return `<tr><td>${esc(r.build)}</td>${flag(inside(keys, t.floor), fmt(keys, 0))}` +
        `${flag(inside(fight, t.fight), fmt(fight, 1))}<td>${esc(r.top_skill ?? "—")}</td>${reach}` +
        `<td class="spread">${r.depth} deep${r.bottom ? ` · ${r.bottom} at the bottom` : ""} · ${r.died} died${died ? ` (${died})` : ""} · ${r.stuck} stuck</td></tr>`;
    }).join("");
    $("floors-table").innerHTML = head + body;
  }
  draw();

  const off = dives.off_target;
  $("off").innerHTML = off.length
    ? `<div class="scroll"><table><tr><th>build</th><th>dive</th><th>what</th><th>measured</th><th>target</th></tr>` +
      off.map((m) => `<tr><td>${esc(m.build)}</td><td>${esc(m.dive)}</td><td>${esc(m.what)}</td>` +
        `<td class="flag">${esc(m.value)}</td><td>${m.range[0]}–${m.range[1]}</td></tr>`).join("") + `</table></div>`
    : '<p class="empty">Every number is inside its target.</p>';
}

render();
</script>
