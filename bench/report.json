<title>Balance Bench</title>
<!--
  The balance bench's readable report (docs/plans/balance.md, slice 6; the
  Floors and Off target panels, docs/plans/floor-bot.md).
  `bench --page FILE` fills the REPORT and PREVIOUS constants with the bench's
  JSON; the /balance-report skill may replace the READING comment below
  with a short written reading before publishing. Nothing here works out a
  number: it only draws what the bench measured.
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap">
<style>
  /* Layout: one column of instrument panels, the summary chart first, the detail tables after. */
  :root {
    --bg: #f3f2ee;
    --panel: #fbfaf7;
    --fg: #1d1f1c;
    --muted: #6a6d64;
    --rule: #d9d7cf;
    --accent: #b5651d;      /* amber: flags and the build in focus */
    --mark: #3d5a4a;        /* the ordinary point and bar */
    --mark-soft: #9bb2a3;
    --up: #2f7a43;
    --down: #a8392f;
    --font-data: "IBM Plex Mono", "DejaVu Sans Mono", ui-monospace, monospace;
    --font-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #121412; --panel: #191c19; --fg: #e3e4dd; --muted: #93978c; --rule: #2e332e;
      --accent: #e0954f; --mark: #8fb79d; --mark-soft: #4d6b58; --up: #7cc48d; --down: #e57a6e;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #121412; --panel: #191c19; --fg: #e3e4dd; --muted: #93978c; --rule: #2e332e;
    --accent: #e0954f; --mark: #8fb79d; --mark-soft: #4d6b58; --up: #7cc48d; --down: #e57a6e;
    color-scheme: dark;
  }
  body {
    background: var(--bg); color: var(--fg); font-family: var(--font-body);
    font-size: 15px; line-height: 1.5;
  }
  main { max-width: 68rem; margin: 0 auto; padding-inline: 16px; padding-block: 2rem 4rem; display: grid; gap: 1.5rem; }
  header { display: grid; gap: .25rem; }
  h1 { font-family: var(--font-data); font-weight: 600; font-size: 1.6rem; margin: 0; letter-spacing: -.01em; }
  h2 { font-family: var(--font-data); font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; margin: 0; color: var(--muted); }
  .meta { font-family: var(--font-data); font-size: .8rem; color: var(--muted); }
  section.panel { background: var(--panel); border: 1px solid var(--rule); border-radius: 4px; padding: 1rem; display: grid; gap: .75rem; min-width: 0; }
  #reading p { margin: 0; max-width: 65ch; }
  #reading { gap: .5rem; }
  .note { color: var(--muted); font-size: .85rem; max-width: 65ch; margin: 0; }
  .tabs { display: flex; flex-wrap: wrap; gap: .4rem; }
  .tabs button {
    font: inherit; font-family: var(--font-data); font-size: .78rem; padding: .3rem .6rem; cursor: pointer;
    background: transparent; color: var(--fg); border: 1px solid var(--rule); border-radius: 3px;
  }
  .tabs button[aria-pressed="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .tabs button:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chart { width: 100%; overflow-x: auto; }
  svg { display: block; width: 100%; height: auto; font-family: var(--font-data); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-family: var(--font-data); font-size: .8rem; font-variant-numeric: tabular-nums; }
  th, td { text-align: right; padding: .35rem .6rem; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  th { color: var(--muted); font-weight: 400; }
  .flag { color: var(--accent); font-weight: 600; }
  .up { color: var(--up); } .down { color: var(--down); }
  .spread { color: var(--muted); }
  details { border-top: 1px solid var(--rule); padding-top: .5rem; }
  details:first-of-type { border-top: 0; padding-top: 0; }
  summary { cursor: pointer; font-family: var(--font-data); font-size: .85rem; }
  details ul { margin: .4rem 0 0; padding-left: 1.2rem; font-size: .85rem; }
  details li span { color: var(--muted); }
  .empty { color: var(--muted); font-size: .85rem; margin: 0; }
</style>

<main>
  <header>
    <h1>Balance bench</h1>
    <div class="meta" id="meta"></div>
  </header>

  <section class="panel" id="reading"><!--READING--></section>

  <section class="panel">
    <h2>Damage against what it takes</h2>
    <p class="note" id="scatter-note"></p>
    <div class="chart" id="scatter"></div>
  </section>

  <section class="panel">
    <h2>Burst and sustained</h2>
    <div class="tabs" id="tabs" role="group" aria-label="Scenario"></div>
    <div class="chart" id="bars"></div>
    <div class="scroll"><table id="table"></table></div>
  </section>

  <section class="panel" id="floors-panel">
    <h2>Floors</h2>
    <p class="note" id="floors-note"></p>
    <div class="tabs" id="dive-tabs" role="group" aria-label="Dive"></div>
    <div class="chart" id="survival"></div>
    <div class="scroll"><table id="floors-table"></table></div>
  </section>

  <section class="panel" id="off-panel">
    <h2>Off target</h2>
    <div id="off"></div>
  </section>

  <section class="panel">
    <h2>What moved</h2>
    <div id="moved"></div>
  </section>

  <section class="panel">
    <h2>When it runs dry</h2>
    <p class="note" id="dry-note"></p>
    <div class="chart" id="dry"></div>
  </section>

  <section class="panel">
    <h2>What each build needs</h2>
    <div id="needs"></div>
  </section>
</main>

