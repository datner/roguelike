// The wanderer: a bow, a torch and the road. The default origin.
(
    inherits: "Player",
    components: [
        Skills({"Archery": 1}),
        // Arrows run out; a wanderer knows how to make more (docs/plans/crafting.md).
        Recipes(["Arrow"]),
    ],
    // The bow takes the right hand, so the torch goes in the left. Leather
    // for the road: the default origin should usually make the first landing.
    equipment: ["ShortBow", "Quiver", "Torch", "LeatherArmor"],
    // Anyone can trip; other techniques come from manuals, inspiration and
    // styles (ADR 0024).
    techniques: ["Trip"],
)
