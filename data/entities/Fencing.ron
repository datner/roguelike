// A style (ADR 0019): a light thrusting blade and nothing in the other hand.
// Its skill grows with every blow that follows it; at 5, a perfect dodge
// is answered at once with a free riposte.
(
    components: [
        Name("fencing"),
        Style(
            domains: [Martial],
            skill: "Fencing",
            follows: ["Pierce", "One-handed", "Empty offhand"],
            principles: [(from_level: 5, does: Riposte)],
        ),
    ],
)
