// A light blade: 1-3 damage plus the wielder's Agility modifier, and a
// chance (out of 10 000) to make each damaging hit bleed.
(
    components: [
        Name("rusty knife"),
        Appearance(glyph: '/', fg: (170, 110, 70), bg: (0, 0, 0)),
        Item,
        Equippable(part: Hand),
        Weapon(min: 1, max: 3, stat: Agility, types: [Slashing]),
        Trains(["Dagger"]),
        OnHit([(effect: "Bleeding", chance_bp: 2500)]),
        // Taken apart: how a knife is made, and nothing worth keeping.
        Salvage(recipe: "Knife"),
    ],
)
