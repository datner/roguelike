// A technique (ADR 0024): a kick that drives the enemy back a step. Struck
// with the leg, not what is in hand (`Blow(unarmed)`), so it is the way to
// fight up close with a bow, or with anything else. Anyone with feet can
// learn it; bow dancing invents it.
(
    components: [
        Name("push kick"),
        Technique(
            domain: Martial,
            verb: "kick",
            at: true,
            reach: 1,
            recharge: 300,
            stamina: 0,
            requires: [Part(Feet)],
            riders: [Shove(tiles: 1)],
            bonuses: [(style: "Bow dancing", from_level: 1, accuracy: 1, recharge_pct: -33)],
            // The bow dance, step 1: push kick, trip, parting shot.
            combo: (group: "bow dance", step: 1, within: 200, xp_pct: 50, display: Steps),
        ),
        Blow(damage_pct: -25, unarmed: true),
    ],
)
