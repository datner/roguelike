// A technique with a wind-up (docs/plans/fights.md): a turn and a half of
// raising the club, the tiles around shown, then a crushing blow on whoever
// is still there. A hit during the wind-up staggers it.
(
    components: [
        Name("heavy swing"),
        Verb(word: "swing"),
        Technique(
            domain: Martial,
            reach: 1,
            recharge: 800,
            stamina: 0,
        ),
        Area(shape: Nova(radius: 1), hits: Enemies),
        Blow(damage_pct: 150),
        WindUp(ticks: 150),
    ],
)
