// A dungeon (game::dungeon): its name, the line logged on reaching each
// floor, how its floors are generated, and what lives on them. Creatures are
// placed in the order listed, then items; `per_floor` adds that many more on
// each floor below the first. Changing the cave tuning or the counts changes
// every seeded world.
(
    name: "the caves",
    arrival: "Goblins prowl these caves.",
    cave: (
        wall_chance: 0.45,
        iterations: 5,
        wall_birth: 5,
        wall_survival: 4,
        min_floor_fraction: 0.35,
    ),
    creatures: [
        (blueprint: "Goblin", count: 6, per_floor: 1),
        (blueprint: "GoblinShaman", count: 1),
    ],
    items: 5,
)
